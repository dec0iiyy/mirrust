# mirrust.service: mirrust on TCP and UDP port 443 as an unprivileged, sandboxed service, with
# a Let's Encrypt certificate that mirrust obtains and renews itself.
#
# Install as /etc/systemd/system/mirrust.service and replace mirror.example.com in the
# --domain argument with your host name, which must have a DNS A record pointing at this
# server. Steps: docs/deploy.md. To use certificate files from certbot instead, see
# "Alternative: certificate files" there.
#
# Needs systemd 247 or later (ProtectProc=): Debian 11, Ubuntu 22.04 or newer.
# Every directive below is documented in systemd.exec(5), systemd.service(5),
# systemd.resource-control(5) or systemd.kill(5).

[Unit]
Description=mirrust, an HTTPS server that reports the client's TLS and HTTP fingerprints
# Start once addresses are configured, so that a --listen with a specific address can bind.
Wants=network-online.target
After=network-online.target
# No start rate limit. A failing service is started again every five seconds (Restart= and
# RestartSec= below) for as long as it fails, and nothing here gives up. The default limit, 5
# starts in 10 seconds, would not stop that either with a 5 second delay; this line keeps it
# that way if a drop-in shortens RestartSec=. RestartSteps= and RestartMaxDelaySec= would give
# a growing delay, but they need systemd 254 (Debian 12 has 252, and older systemd ignores
# unknown directives with a warning), so they are not used.
StartLimitIntervalSec=0

[Service]
# "exec" reports a missing or non-executable binary as a start failure ("simple" would not).
Type=exec
# --listen takes one address. 0.0.0.0 is IPv4 only; see docs/deploy.md for IPv6.
# TCP on it serves HTTP/1.1 and HTTP/2, UDP on the same port serves HTTP/3.
# --domain makes mirrust obtain a Let's Encrypt certificate for that name and renew it before
# it expires, answering the validation on TCP port 443 (TLS-ALPN-01), so no other port needs
# to be open. It means accepting the Let's Encrypt Subscriber Agreement,
# https://letsencrypt.org/repository/ . Add --acme-email you@example.com for expiry notices,
# and --acme-staging to try it first against the staging CA, whose certificates browsers
# do not trust.
# --acme-dir is where the account key and the certificate are kept, so that a restart does
# not order again. ${STATE_DIRECTORY} is set by systemd because of StateDirectory= below.
ExecStart=/usr/local/bin/mirrust \
    --listen 0.0.0.0:443 \
    --domain mirror.example.com \
    --acme-dir ${STATE_DIRECTORY} \
    --log /var/log/mirrust/requests.jsonl

# Stop with SIGINT instead of the default SIGTERM: mirrust handles SIGINT (Ctrl-C) by
# writing out the request log before it exits. systemd counts an exit on SIGINT as clean.
KillSignal=SIGINT
# After this long without an exit, systemd sends SIGKILL.
TimeoutStopSec=20s

# Restart after a crash, a non-zero exit or an out-of-memory kill; not after "systemctl stop".
# A start that fails at once, for example because --domain is not a valid name, is retried
# too; "systemctl status mirrust" and the journal show the reason.
Restart=on-failure
RestartSec=5s

# --- User and privileges ---

# Run as a user that exists only while the service runs. systemd allocates it and names it
# after the unit; there is no account to create or remove.
DynamicUser=yes
# The only capability: binding ports below 1024, which covers TCP 443 and UDP 443.
# AmbientCapabilities= gives it to the non-root process; CapabilityBoundingSet= makes it the
# only capability the process can ever hold.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# No privilege gain through setuid or setgid programs or file capabilities.
NoNewPrivileges=yes
# Do not add PrivateUsers=yes: in a private user namespace the capability above no longer
# applies to the host's network namespace, and binding port 443 fails.

# --- File system ---

# The whole file system is read-only for the service, except the directories named below.
ProtectSystem=strict
# /home, /root and /run/user are not visible at all.
ProtectHome=yes
# Private /tmp and /var/tmp.
PrivateTmp=yes
# No physical devices in /dev; /dev/null, /dev/urandom and similar stay.
PrivateDevices=yes
# Creates /var/log/mirrust, owned by the service user and writable by it, for the request
# log. With DynamicUser= the directory is really /var/log/private/mirrust, and
# /var/log/mirrust is a symbolic link to it; /var/log/private is closed to other users.
LogsDirectory=mirrust
LogsDirectoryMode=0750
# Creates /var/lib/mirrust, owned by the service user and writable by it, for the ACME account
# key and the certificate, and gives it to mirrust as $STATE_DIRECTORY. Only that user can
# open it. With DynamicUser= the directory is really /var/lib/private/mirrust, and
# /var/lib/mirrust is a symbolic link to it; /var/lib/private is closed to other users. The
# directory is kept when the service stops.
StateDirectory=mirrust
StateDirectoryMode=0700
# New files, the request log included, are not readable by other users.
UMask=0027

# --- Kernel interfaces ---

# The service cannot write kernel tunables in /proc and /sys, load kernel modules, read the
# kernel log, change control groups, set the clock or change the host name.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Hide other users' processes in /proc.
ProtectProc=invisible
# New sockets: IPv4 and IPv6 for the listeners, and AF_UNIX, which the C library may use for
# local lookups. No netlink, packet or other families.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No new namespaces, no realtime scheduling, no setuid or setgid files, no change of the
# execution domain (personality).
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No memory that is writable and executable at once; mirrust generates no code at run time.
MemoryDenyWriteExecute=yes
# Remove the service user's System V and POSIX IPC objects when the service stops.
RemoveIPC=yes
# Only the system calls of systemd's "@system-service" set, the usual set for a daemon, and
# only for the machine's native architecture. A call outside the set fails with EPERM
# instead of killing the process.
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# --- Resources ---

# Upper bound on the service's memory. At the limit the kernel kills the process and
# Restart=on-failure starts it again. An idle mirrust uses a few megabytes; each open
# connection adds its buffers (see "Bounded memory per client" in docs/architecture.md).
MemoryMax=256M
# Open files. Every TCP connection takes one descriptor for up to 15 seconds.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
